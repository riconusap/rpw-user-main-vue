{
  "name": "rpw-law-firm",
  "version": "1.0.0",
  "description": "R. Prama Wijaya Law Firm Website - Vue 3 TypeScript",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "vite preview",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml build",
    "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
    "docker:clean": "docker-compose down -v && docker system prune -af"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@vueuse/head": "^2.0.0",
    "aos": "^2.3.4",
    "bootstrap": "^4.6.2",
    "counterup": "^1.0.2",
    "jquery": "^3.7.1",
    "jquery.easing": "^1.4.1",
    "owl.carousel": "^2.3.4",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "waypoints": "^4.0.1"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/jquery": "^3.5.29",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.9.3",
